def EFX.Inst.bundleVal (I : EFX.Inst) (X : EFX.Inst.Alloc I) (i j : Fin (EFX.Inst.n I))
  (ex : Option (Fin (EFX.Inst.m I))) :
  Nat :=
  EFX.finSum (EFX.Inst.m I)
    (fun (g : Fin (EFX.Inst.m I)) =>
    ite (And (Eq (X g) j) (Ne ex (Option.some g))) (EFX.Inst.v I i g) (OfNat.ofNat 0))

def EFX.Inst.EFX0 (I : EFX.Inst) (X : EFX.Inst.Alloc I) : Prop :=
  forall (i j : Fin (EFX.Inst.n I)),
  Ne i j → (forall (g : Fin (EFX.Inst.m I)),
  Eq (X g) j → LE.le (EFX.Inst.bundleVal I X i j (Option.some g))
    (EFX.Inst.bundleVal I X i i Option.none))

def EFX.numRelevant (I : EFX.Inst) (i : Fin (EFX.Inst.n I)) : Nat :=
  EFX.finSum (EFX.Inst.m I)
    (fun (g : Fin (EFX.Inst.m I)) =>
    ite (LT.lt (OfNat.ofNat 0) (EFX.Inst.v I i g)) (OfNat.ofNat 1) (OfNat.ofNat 0))

