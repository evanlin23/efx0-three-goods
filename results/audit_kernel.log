def Audit.IsPartition :
  forall {n m : Nat}, (Fin n → List (Fin m)) → Prop :=
  fun {n m : Nat} (X : Fin n → List (Fin m)) =>
  And (forall (i : Fin n), List.Nodup (X i))
    (And (forall (g : Fin m), Exists (fun (i : Fin n) => Membership.mem (X i) g))
      (forall (i j : Fin n) (g : Fin m),
      Membership.mem (X i) g → Membership.mem (X j) g → Eq i j))

def Audit.IsEFX0 :
  forall {n m : Nat}, (Fin n → Fin m → Nat) → (Fin n → List (Fin m)) → Prop :=
  fun {n m : Nat} (v : Fin n → Fin m → Nat) (X : Fin n → List (Fin m)) =>
  forall (i j : Fin n),
  Ne i j → (forall (g : Fin m),
  Membership.mem (X j) g → LE.le (Audit.lsum (v i) (List.erase (X j) g)) (Audit.lsum (v i) (X i)))

def Audit.relevant :
  forall {n m : Nat}, (Fin n → Fin m → Nat) → Fin n → List (Fin m) :=
  fun {n m : Nat} (v : Fin n → Fin m → Nat) (i : Fin n) =>
  List.filter (fun (g : Fin m) => Decidable.decide (LT.lt (OfNat.ofNat 0) (v i g)))
    (List.finRange m)

def Audit.total :
  forall {n m : Nat}, (Fin n → Fin m → Nat) → Fin n → Nat :=
  fun {n m : Nat} (v : Fin n → Fin m → Nat) (i : Fin n) => Audit.lsum (v i) (List.finRange m)

def Audit.Balanced :
  forall {n m : Nat}, (Fin n → Fin m → Nat) → Prop :=
  fun {n m : Nat} (v : Fin n → Fin m → Nat) =>
  forall (i : Fin n) (g : Fin m),
  LE.le (HMul.hMul (OfNat.ofNat 2) (v i g)) (Audit.total v i)

def Audit.TargetStmt :
  Prop :=
  forall (n m : Nat) (v : Fin n → Fin m → Nat),
  LT.lt (OfNat.ofNat 0) n → (forall (i : Fin n),
    LE.le (List.length (Audit.relevant v i)) (OfNat.ofNat 3)) →
  Exists (fun (X : Fin n → List (Fin m)) => And (Audit.IsPartition X) (Audit.IsEFX0 v X))

def Audit.DStmt :
  Prop :=
  forall (n m : Nat) (v : Fin n → Fin m → Nat),
  LT.lt (OfNat.ofNat 0) n → (forall (i : Fin n),
    Eq (List.length (Audit.relevant v i)) (OfNat.ofNat 3)) →
  Audit.Balanced v → Exists
    (fun (X : Fin n → List (Fin m)) =>
    And (Audit.IsPartition X)
      (And (Audit.IsEFX0 v X)
        (forall (j k : Fin n),
        LT.lt (OfNat.ofNat 2) (List.length (X j)) → LT.lt (OfNat.ofNat 2) (List.length (X k)) →
        Eq j k)))

